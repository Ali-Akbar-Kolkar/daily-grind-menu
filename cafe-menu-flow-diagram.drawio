<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-26T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram name="Cafe Menu Data Flow" id="cafe-menu-flow">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Step 1: Cafe Owner -->
        <mxCell id="owner" value="Cafe Owner" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Step 2: Edits Google Sheet -->
        <mxCell id="edit" value="Edits menu item / price&#10;in Google Sheet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="80" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Step 3: Google Sheet (Drive) -->
        <mxCell id="sheet" value="Google Sheet&#10;(stored in Drive)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="140" height="100" as="geometry" />
        </mxCell>

        <!-- Step 4: Published as CSV -->
        <mxCell id="csv" value="Published to Web&#10;as live CSV link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="80" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Step 5: User opens webpage -->
        <mxCell id="user" value="Customer opens the&#10;GitHub Pages webpage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Step 6: JS fetch() call -->
        <mxCell id="fetch" value="JavaScript fetch(CSV_URL)&#10;runs on page load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="280" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Step 7: PapaParse -->
        <mxCell id="parse" value="PapaParse converts&#10;CSV text to JSON array" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="280" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Step 8: Render cards -->
        <mxCell id="render" value="Menu cards rendered&#10;dynamically on page&#10;(grouped by category)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="270" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Step 9: GitHub Pages hosting note -->
        <mxCell id="github" value="Hosted on GitHub Pages&#10;(index.html / style.css / script.js)&#10;— code never changes, only data does" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="420" width="480" height="70" as="geometry" />
        </mxCell>

        <!-- Arrows: top row -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="owner" target="edit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="edit" target="sheet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="sheet" target="csv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrows: bottom row -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="user" target="fetch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="fetch" target="parse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="parse" target="render">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Vertical connector: csv link is what fetch reads -->
        <mxCell id="e7" value="fetch reads this&#10;live CSV link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1" source="csv" target="fetch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="820" y="200" />
              <mxPoint x="430" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Title -->
        <mxCell id="title" value="Dynamic Cafe Menu — Google Sheet to GitHub Pages Flow" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="10" width="600" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
