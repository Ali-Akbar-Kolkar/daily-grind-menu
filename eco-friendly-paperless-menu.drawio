<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-26T10:30:00.000Z" agent="GitHub Copilot" version="24.0.0" type="device">
  <diagram name="Paperless Menu" id="eco-paperless-menu">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Eco-Friendly, Paperless &amp; Plastic-Free Menu" style="text;html=1;fontSize=26;fontStyle=1;align=center;fontColor=#174A35;" vertex="1" parent="1">
          <mxGeometry x="90" y="34" width="920" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One simple update keeps the cafe menu current for everyone" style="text;html=1;fontSize=15;align=center;fontColor=#52645B;" vertex="1" parent="1">
          <mxGeometry x="180" y="92" width="740" height="35" as="geometry" />
        </mxCell>

        <mxCell id="staff" value="CAFE TEAM&#10;Adds or changes items, prices&#10;and availability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2E8;strokeColor=#4F8A62;fontColor=#174A35;fontSize=16;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="220" width="210" height="125" as="geometry" />
        </mxCell>
        <mxCell id="sheet" value="GOOGLE SHEET&#10;The cafe's menu control panel&#10;Easy to update, no code needed" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFF2CC;strokeColor=#D6A62E;fontColor=#51421A;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="365" y="205" width="220" height="155" as="geometry" />
        </mxCell>
        <mxCell id="website" value="LIVE DIGITAL MENU&#10;A mobile-friendly webpage&#10;Shows current items and prices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#5482A8;fontColor=#23465F;fontSize=16;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="220" width="210" height="125" as="geometry" />
        </mxCell>
        <mxCell id="customer" value="CUSTOMER&#10;Scans the cafe QR code&#10;and views the menu on a phone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C77950;fontColor=#65371F;fontSize=16;fontStyle=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="910" y="220" width="170" height="125" as="geometry" />
        </mxCell>

        <mxCell id="staff-to-sheet" value="1. Update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4F8A62;strokeWidth=2;fontSize=12;fontColor=#174A35;endArrow=block;endFill=1;" edge="1" parent="1" source="staff" target="sheet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sheet-to-web" value="2. Syncs automatically" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5482A8;strokeWidth=2;fontSize=12;fontColor=#23465F;endArrow=block;endFill=1;" edge="1" parent="1" source="sheet" target="website">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="web-to-customer" value="3. View" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C77950;strokeWidth=2;fontSize=12;fontColor=#65371F;endArrow=block;endFill=1;" edge="1" parent="1" source="website" target="customer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="qr" value="QR CODE ON THE TABLE&#10;Opens the live menu link&#10;No app download required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F6F2;strokeColor=#89A18E;fontColor=#34463A;fontSize=14;align=center;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="895" y="405" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="qr-to-customer" value="scan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#89A18E;strokeWidth=2;dashed=1;fontSize=11;endArrow=block;endFill=1;" edge="1" parent="1" source="qr" target="customer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="benefits-title" value="WHY IT IS ECO-FRIENDLIER" style="text;html=1;fontSize=17;fontStyle=1;align=center;fontColor=#174A35;" vertex="1" parent="1">
          <mxGeometry x="90" y="545" width="920" height="35" as="geometry" />
        </mxCell>
        <mxCell id="benefit-paper" value="LESS PAPER&#10;Fewer reprinted menus when prices or items change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2E8;strokeColor=#4F8A62;fontColor=#174A35;fontSize=14;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="115" y="600" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="benefit-plastic" value="LESS PLASTIC&#10;No need for plastic menu sleeves or disposable menus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2E8;strokeColor=#4F8A62;fontColor=#174A35;fontSize=14;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="425" y="600" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="benefit-current" value="ALWAYS CURRENT&#10;Change the sheet once; customers see the updated menu online" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F2E8;strokeColor=#4F8A62;fontColor=#174A35;fontSize=14;fontStyle=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="735" y="600" width="250" height="90" as="geometry" />
        </mxCell>

        <mxCell id="privacy" value="ACCESS CONTROL: Customers can view the published menu. Only people the cafe authorizes can edit the Google Sheet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F6F2;strokeColor=#AAB7AE;fontColor=#34463A;fontSize=13;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="740" width="760" height="52" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
